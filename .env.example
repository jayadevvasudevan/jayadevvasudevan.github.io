# Instagram API Configuration
# Get these values from your Facebook Developer App

# Your Facebook App ID
REACT_APP_INSTAGRAM_APP_ID=your_app_id_here

# Your Instagram Business Account ID
REACT_APP_INSTAGRAM_USER_ID=your_instagram_user_id_here

# Your Instagram Access Token (Keep this secure!)
REACT_APP_INSTAGRAM_ACCESS_TOKEN=your_access_token_here

# Optional: Facebook App Secret (for server-side operations only)
# Never expose this in client-side code!
INSTAGRAM_APP_SECRET=your_app_secret_here

# API Configuration
REACT_APP_INSTAGRAM_API_VERSION=v18.0
REACT_APP_INSTAGRAM_API_BASE_URL=https://graph.instagram.com